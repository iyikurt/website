DEV_OUTPUT = <<-'TXT'
  [development] blog is ready to lead at http://localhost:3000
  TXT
DEV_BODY = <<-'TXT'
  <ul><li><strong>It watches</strong> <code>app/</code>, <code>config/</code>, <code>db/schema.json</code> and <code>iyi.mod</code>.</li><li><strong>It builds beside the running server.</strong> When the build succeeds, the new server replaces the old one and the page reloads, through <code>live_reload_tag</code> at the bottom of the layout.</li><li><strong>A change that does not build</strong> shows the error at your line, and the last good server keeps answering.</li><li><strong><code>public/</code> is served from disk.</strong> It needs no restart.</li></ul>
  TXT

# build
BUILD_CODE = <<-'TXT'
  export KURT_ENV=production
  export DATABASE_URL=postgres://app@db.local/blog
  export SESSION_SECRET=$(openssl rand -hex 32)   # once, and kept
  ./bin/blog db:migrate
  ./bin/blog -b 0.0.0.0 -p 8080
  TXT
BUILD_OUTPUT = <<-'TXT'
  5.1M    bin/blog
  TXT
BUILD_BODY = <<-'TXT'
  <p><code>kurt build</code> compiles the application into <code>bin/NAME</code>, with the CSS minified. Copy it and <code>public/</code> to the server.</p><ul><li><strong>A real secret.</strong> Production refuses to start without a <code>SESSION_SECRET</code> of 32 bytes or more.</li><li><strong>Behind a proxy.</strong> The session cookie is <code>Secure</code>; nginx, Caddy or a load balancer ends TLS.</li><li><strong>A health check.</strong> <code>GET /up</code> answers 200 when the application and its database are up.</li><li><strong>A clean stop.</strong> On <code>TERM</code> the server takes no new connections and finishes the ones it has.</li></ul>
  TXT

# A List, not an Array: requests are served on many threads, and only a
# shareable, unchanging value may be read by all of them.
TOPICS = List.new([
  Topic.new("install", "Start",
    "Install Kurt from source, next to iyi.",
    "sh", INSTALL_CODE, "kurt version", INSTALL_OUTPUT, INSTALL_BODY,
    "kurt version", "It prints its version when it is on your PATH."),
  Topic.new("new", "Start",
    "Create a new application with one command.",
    "sh", NEW_CODE, "kurt new blog --css none", NEW_OUTPUT, NEW_BODY,
    "kurt new blog\ncd blog\nkurt dev", "Then open localhost:3000."),
  Topic.new("scaffold", "Start",
    "Generate a model, a migration, a controller, views, routes and a test with one command.",
    "sh", SCAFFOLD_CODE, "kurt g scaffold · kurt db:migrate", SCAFFOLD_OUTPUT, SCAFFOLD_BODY,
    "kurt g scaffold Post title:string body:text published:bool\nkurt db:migrate\nkurt dev", "Then open localhost:3000/posts and add one."),
  Topic.new("layout", "Application",
    "Where each file goes, and why you don't write imports.",
    "blog/", LAYOUT_CODE, ".kurt/build/", LAYOUT_OUTPUT, LAYOUT_BODY,
    "kurt build\nls .kurt/build", "Build once, then look at what the build wrote."),
  Topic.new("agents", "Application",
    "<code>AGENTS.md</code> tells coding agents how your application works.",
    "AGENTS.md", AGENTS_CODE, "CLAUDE.md", AGENTS_OUTPUT, AGENTS_BODY,
    "cat AGENTS.md", "Read what your agent reads."),
  Topic.new("models", "Models",
    "Models get their columns from the database; you only write the behaviour.",
    "app/models/post.iyi", MODELS_CODE, "db/schema.json", MODELS_OUTPUT, MODELS_BODY,
    "kurt g model Comment body:text post:references\nkurt db:migrate", "Add a model that belongs to Post."),
  Topic.new("migrations", "Models",
    "Change the database with plain SQL files.",
    "db/migrations/20261126212518_create_posts.sql", MIGRATIONS_CODE, "kurt db:migrate · kurt db:status", MIGRATIONS_OUTPUT, MIGRATIONS_BODY,
    "kurt g migration add_slug_to_posts\nkurt db:migrate\nkurt db:status", "Write a migration and run it."),
  Topic.new("queries", "Models",
    "Find, filter and save records, and pass errors on with <code>!</code>.",
    "in an action", QUERIES_CODE, "", "", QUERIES_BODY,
    "kurt dev", "Change a query in an action; the page reloads."),
  Topic.new("views", "Views",
    "Write pages as HTML with iyi code inside.",
    "app/views/posts/index.eiy", VIEWS_CODE, "", "", VIEWS_BODY,
    "kurt dev", "Edit a view while it runs; the page reloads itself."),
  Topic.new("controllers", "Controllers",
    "Controllers handle requests: they load data and render a view.",
    "app/controllers/posts_controller.iyi", CONTROLLERS_CODE, "", "", CONTROLLERS_BODY,
    "kurt g controller Pages about contact", "Generate two actions with their views and routes."),
  Topic.new("errors", "Controllers",
    "Return an error with <code>!</code>, and Kurt turns it into the right response.",
    "app/controllers/application_controller.iyi", ERRORS_CODE, "", "", ERRORS_BODY,
    "kurt g authentication\nkurt db:migrate", "Add sign-in; every page then asks for it."),
  Topic.new("routes", "Routing",
    "Connect URLs to controller actions in one file.",
    "config/routes.iyi", ROUTES_CODE, "kurt routes", ROUTES_OUTPUT, ROUTES_BODY,
    "kurt routes", "Print every route."),
  Topic.new("tests", "Shipping",
    "Test your app through its routes, on a fresh database.",
    "test/posts_test.iyi", TESTS_CODE, "kurt test", TESTS_OUTPUT, TESTS_BODY,
    "kurt test", "Run the scaffold's test."),
  Topic.new("dev", "Shipping",
    "Keep the app running while you work; it rebuilds when you save.",
    "app/views/layouts/application.eiy", DEV_CODE, "kurt dev", DEV_OUTPUT, DEV_BODY,
    "kurt dev -p 3000", "Keep it running while you edit."),
  Topic.new("build", "Shipping",
    "Build one file and run it on your server.",
    "on the server", BUILD_CODE, "kurt build · du -h bin/blog", BUILD_OUTPUT, BUILD_BODY,
    "kurt build\ndu -h bin/blog", "Build the release binary and see its size."),
])
