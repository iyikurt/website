import std/list::{List}

# The docs' topics, in the order the sidebar lists them. Each one shows one
# file or command and what it printed. The files and the output are a real
# application's: `kurt new blog --css none`, then `kurt g scaffold Post
# title:string body:text published:bool` and `kurt db:migrate`.
struct Topic
  getter slug : String
  getter section : String
  getter lead : String
  getter path : String
  getter code : String
  getter out_caption : String
  getter output : String
  getter body : String
  getter command : String
  getter try_it : String

  def initialize(@slug : String, @section : String, @lead : String, @path : String,
                 @code : String, @out_caption : String, @output : String,
                 @body : String, @command : String, @try_it : String)
  end
end

# install
INSTALL_CODE = <<-'TXT'
  git clone https://github.com/iyikurt/kurt.git ~/src/kurt
  cd ~/src/kurt
  make install                 # links bin/kurt into ~/.local/bin
  export PATH="$HOME/.local/bin:$PATH"
  TXT
INSTALL_OUTPUT = <<-'TXT'
  kurt 0.1.0
  TXT
INSTALL_BODY = <<-'TXT'
  <ul><li><strong>iyi 0.21.0 or later.</strong> Tried with 0.22.0.</li><li><strong>A C compiler.</strong> <code>cc</code> links the program and the SQLite bindings.</li><li><strong>SQLite.</strong> macOS already has it. PostgreSQL is optional, through <code>DATABASE_URL</code>.</li></ul><p>Kurt is an iyi package, <code>github.com/iyikurt/kurt</code>, versioned by git tags. <code>kurt new</code> writes its own version into the application's <code>iyi.mod</code>, and iyi fetches the package on the first build. <code>KURT_PATH=~/src/kurt kurt new app</code> builds against your checkout instead.</p>
  TXT

# new
NEW_CODE = <<-'TXT'
  kurt new blog --css none
  cd blog
  kurt dev
  TXT
NEW_OUTPUT = <<-'TXT'
      create  iyi.mod
      create  config/application.iyi
      create  config/routes.iyi
      create  app/models/.keep
      create  app/controllers/application_controller.iyi
      create  app/controllers/home_controller.iyi
      create  app/views/layouts/application.eiy
      create  app/views/home/index.eiy
      create  public/assets/app.css
      create  public/icon.svg
      create  db/migrations/.keep
      create  test/fixtures/.keep
      create  db/seeds.iyi
      create  .gitignore
      create  AGENTS.md
      create  CLAUDE.md

  Created blog. Next:
    cd blog
    kurt generate scaffold Post title:string body:text published:bool
    kurt db:migrate
    kurt dev
  TXT
NEW_BODY = <<-'TXT'
  <p>Sixteen files: the configuration, a home page and its layout, a stylesheet, folders for the database and the tests, and the two files a coding agent reads first. <code>kurt dev</code> serves it at <code>localhost:3000</code>.</p><ul><li><strong>With Tailwind CSS and daisyUI by default.</strong> The standalone Tailwind CLI is fetched once into <code>~/.cache/kurt/</code> and checked against the release's checksums. No Node.</li><li><strong>Or with plain CSS.</strong> <code>--css none</code> leaves both out, as here.</li></ul>
  TXT

# scaffold
SCAFFOLD_CODE = <<-'TXT'
  kurt generate scaffold Post title:string body:text published:bool
  kurt db:migrate
  TXT
SCAFFOLD_OUTPUT = <<-'TXT'
      create  app/models/post.iyi
      create  db/migrations/20261126212518_create_posts.sql
      create  app/controllers/posts_controller.iyi
      create  app/views/posts/index.eiy
      create  app/views/posts/show.eiy
      create  app/views/posts/new.eiy
      create  app/views/posts/edit.eiy
      create  app/views/posts/_form.eiy
      update  config/routes.iyi
      update  app/views/layouts/application.eiy
      create  test/posts_test.iyi
     migrate  20261126212518_create_posts
        dump  db/schema.json
      update  app/models/post.iyi
  TXT
SCAFFOLD_BODY = <<-'TXT'
  <p>A field is <code>name:type</code>. The types are <code>string</code>, <code>text</code>, <code>int</code>, <code>float</code>, <code>bool</code>, <code>time</code> and <code>references</code>; <code>user:references</code> gives a <code>user_id</code> column and <code>belongs_to user</code>. <code>g</code> is short for <code>generate</code>.</p><table><thead><tr><th>Command</th><th>Writes</th></tr></thead><tbody><tr><td><code>kurt g scaffold</code></td><td>model, migration, controller, five views, routes, test</td></tr><tr><td><code>kurt g model</code></td><td>model and migration</td></tr><tr><td><code>kurt g controller</code></td><td>controller, views, routes</td></tr><tr><td><code>kurt g migration</code></td><td>an empty migration</td></tr><tr><td><code>kurt g authentication</code></td><td>users, sign-in, sign-up</td></tr></tbody></table>
  TXT

# layout
LAYOUT_CODE = <<-'TXT'
  blog/
  ├── app/
  │   ├── controllers/                    # C: one class per resource
  │   │   ├── application_controller.iyi  # shared by every controller
  │   │   └── home_controller.iyi
  │   ├── models/                         # M: one class per table
  │   └── views/                          # V: .eiy templates
  │       ├── home/index.eiy
  │       └── layouts/application.eiy     # the page around every view
  ├── config/
  │   ├── application.iyi                 # runs at start: middleware
  │   └── routes.iyi                      # every route
  ├── db/
  │   ├── migrations/                     # plain SQL, -- up and -- down
  │   └── seeds.iyi                       # a new database's first rows
  ├── public/                             # served from disk as it is
  │   ├── assets/app.css
  │   └── icon.svg
  ├── test/                               # *_test.iyi, through the routes
  │   └── fixtures/                       # the rows a test starts from
  ├── AGENTS.md                           # the rules, for coding agents
  ├── CLAUDE.md                           # @AGENTS.md
  └── iyi.mod                             # dependencies
  TXT
LAYOUT_OUTPUT = <<-'TXT'
  app/controllers.iyi
  app/fixtures.iyi
  app/models.iyi
  app/routes.iyi
  blog.iyi
  iyi.mod
  posts_test.iyi
  TXT
LAYOUT_BODY = <<-'TXT'
  <p>What you write has no module header and no imports. <code>kurt dev</code>, <code>kurt test</code> and <code>kurt build</code> turn it into iyi modules under <code>.kurt/build/</code>, which you never edit:</p><ul><li><strong>Every model goes into one module,</strong> with a <code>property</code> for each column. iyi forbids import cycles, and in one module a User and its Posts may still name each other.</li><li><strong>Every controller goes into another,</strong> <code>ApplicationController</code> first.</li><li><strong><code>config/routes.iyi</code> becomes the router's body.</strong> </li></ul><p>A build error still points at your file and line. A file that needs another module writes its own <code>import</code> at the top.</p>
  TXT

# agents
AGENTS_CODE = <<-'TXT'
  # blog

  A Kurt application: an MVC web framework on iyi (https://iyi.dev), over
  iyi-web (HTTP, routing, templates, sessions, CSRF) and db (SQL, pools).

  ## Layout

  No .iyi file here has a module header or imports. `kurt dev` and `kurt test`
  compile them into modules under .kurt/build/ (generated: never edit it), adding the
  imports each kind needs; errors still point at these files.

  - `config/application.iyi`: runs at start. Middleware: method override, session cookie, CSRF.
  - `config/routes.iyi`: `root HomeController, :index`, `resources "posts", PostsController`
    (the REST routes for the actions the controller defines), `get "/about", PagesController, :about`.
    A block nests resources (`/posts/:post_id/comments`); `namespace "admin" do ... end` prefixes paths.
    `kurt routes` prints every route.
  - `app/models/<model>.iyi`: `class Post < ApplicationRecord`, one per file.
  - `app/controllers/<plural>_controller.iyi`: `class PostsController < ApplicationController`.
  - `app/views/<plural>/<action>.eiy`: templates. `<%= expr %>` escapes; `raw(x)` does not.
  - `db/migrations/<timestamp>_<name>.sql`: `-- up` and `-- down` sections of plain SQL.
  - `test/<name>_test.iyi`: tests through the routes (`dispatch(RouteHandler.new(routes), ...)`).
  - A file that needs another module adds its own `import` line at the top.
  TXT
AGENTS_OUTPUT = <<-'TXT'
  @AGENTS.md
  TXT
AGENTS_BODY = <<-'TXT'
  <p>Codex, Cursor, Copilot and Gemini CLI read <code>AGENTS.md</code> from a project's root on their own. <code>kurt new</code> writes it with what an agent would otherwise guess:</p><ul><li><strong>The layout.</strong> Which file holds what, and that no file has imports.</li><li><strong>The commands.</strong> Every <code>kurt</code> command and what it does.</li><li><strong>The rules of each part.</strong> How a model answers an error, what a controller may call, how a view escapes.</li></ul><p>Claude Code reads <code>CLAUDE.md</code> instead, so that file is one line, <code>@AGENTS.md</code>. One set of rules, in one place.</p>
  TXT

# models
MODELS_CODE = <<-'TXT'
  # Columns of posts (db/schema.json, kept up to date by `kurt db:migrate`):
  #   id          Int64
  #   title       String
  #   body        String
  #   published   Bool
  #   created_at  Time
  #   updated_at  Time
  class Post < ApplicationRecord
    validates :title, presence: true
  end
  TXT
MODELS_OUTPUT = <<-'TXT'
  {
    "posts": [
      {"name": "id", "sql": "INTEGER", "type": "Int64"},
      {"name": "title", "sql": "TEXT", "type": "String"},
      {"name": "body", "sql": "TEXT", "type": "String"},
      {"name": "published", "sql": "BOOLEAN", "type": "Bool"},
      {"name": "created_at", "sql": "DATETIME", "type": "Time"},
      {"name": "updated_at", "sql": "DATETIME", "type": "Time"}
    ]
  }
  TXT
MODELS_BODY = <<-'TXT'
  <p><code>kurt db:migrate</code> writes <code>db/schema.json</code>, and the build declares a typed <code>property</code> for each column, nilable when the column allows NULL. A <code>property</code> the model writes itself wins.</p><pre><code>class Post &lt; ApplicationRecord
    belongs_to user : User
    has_many comments : Comment, dependent: :destroy

    validates :title, presence: true
    validates :title, length: {maximum: 120}
    before_validation :strip_title
  end</code></pre><ul><li><strong>Associations.</strong> <code>belongs_to</code>, <code>has_many</code> and <code>has_one</code>, with <code>dependent:</code>.</li><li><strong>Validations.</strong> <code>presence</code>, <code>length</code>, <code>format</code>, <code>inclusion</code>, <code>uniqueness</code>, then the model's own <code>validate(errors)</code>.</li><li><strong>Callbacks.</strong> In order, from <code>before_validation</code> to <code>after_save</code>.</li></ul>
  TXT

# migrations
MIGRATIONS_CODE = <<-'TXT'
  -- up
  CREATE TABLE posts (
    id INTEGER PRIMARY KEY,
    title TEXT NOT NULL DEFAULT '',
    body TEXT NOT NULL DEFAULT '',
    published BOOLEAN NOT NULL DEFAULT 0,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
  );

  -- down
  DROP TABLE posts;
  TXT
MIGRATIONS_OUTPUT = <<-'TXT'
     migrate  20261126212518_create_posts
        dump  db/schema.json
      update  app/models/post.iyi

    up    20261126212518_create_posts
  TXT
MIGRATIONS_BODY = <<-'TXT'
  <p>The generators write SQLite, or PostgreSQL when <code>DATABASE_URL</code> is a <code>postgres://</code> URL.</p><table><thead><tr><th>Command</th><th>Does</th></tr></thead><tbody><tr><td><code>kurt db:migrate</code></td><td>runs what is pending, rewrites <code>db/schema.json</code></td></tr><tr><td><code>kurt db:rollback [N]</code></td><td>undoes the last N</td></tr><tr><td><code>kurt db:status</code></td><td>lists what has run</td></tr><tr><td><code>kurt db:reset</code></td><td>drops the SQLite database, migrates, seeds</td></tr><tr><td><code>kurt db:seed</code></td><td>runs <code>db/seeds.iyi</code></td></tr></tbody></table><p><code>db/seeds.iyi</code> writes a new database's first rows with the models, and runs again without doubles:</p><pre><code>ada = User.find_or_create_by(email: "ada@example.com") do |user|
    user.name = "Ada"
  end!</code></pre>
  TXT

# queries
QUERIES_CODE = <<-'TXT'
  posts = Post.where(published: true).order_desc(:id).paginate(params[:page]?, per: 20).all!
  post  = Post.find(params[:id])!          # a 404 when missing
  maybe = Post.find?(params[:id])          # nil when missing

  # a list and its associations in two queries, not N+1
  posts = Post.includes(:user, :comments).all!

  # both rows, or neither
  Post.transaction do |tx|
    post = Post.create(attrs, on: tx)!
    Comment.create(on: tx, post_id: post.id, body: "first")!
    post
  end
  TXT
QUERIES_BODY = <<-'TXT'
  <p>iyi has no exceptions. A call answers <code>Post | NotFound | DBError</code>, and <code>!</code> passes the error to the one place that turns it into a response.</p><ul><li><strong>Typed finders.</strong> Each column has one: <code>Post.title("Hello").first?</code>.</li><li><strong>No N+1.</strong> After <code>includes</code>, <code>post.user</code> and <code>post.comments</code> ask the database nothing more.</li><li><strong>Transactions.</strong> A block that answers an error rolls everything back.</li></ul>
  TXT

